# The application in production. Copy to .env.production and fill in; that file is
# ignored by git and never enters the image — the containers get these values
# as their environment.

# ── Aplikasi ──────────────────────────────────────────────────────────────────
# Nama yang tampil di layar, surel, dan dokumen.
APP_NAME=Taflow
# Nama stack di Docker; image-nya bernama <nama ini>:latest.
COMPOSE_PROJECT_NAME=taflow
APP_ENV=production
APP_DEBUG=false
# Buat sekali dengan: docker run --rm taflow:latest php artisan key:generate --show
APP_KEY=
# Alamat yang diketik pengguna di peramban, lengkap dengan https://
APP_URL=https://taflow.kampus.ac.id

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ── Gateway ───────────────────────────────────────────────────────────────────
# Alamat atau rentang CIDR gateway nginx, dipisah koma. Hanya dari alamat ini
# X-Forwarded-For / -Proto / -Host dipercaya. Tanpa ini tautan dibuat http://
# dan log audit mencatat alamat gateway untuk semua orang.
TRUSTED_PROXIES=10.0.0.5

# Alamat host tempat port aplikasi dibuka. Isi dengan IP privat host ini yang
# dijangkau gateway; 127.0.0.1 berarti hanya host ini sendiri.
APP_BIND=127.0.0.1
APP_PORT=8000

# ── Basis data (MySQL) ────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=taflow
DB_USERNAME=taflow
DB_PASSWORD=

# ── Redis: cache dan sesi ─────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=null
# Pembeda kunci bila Redis ini dipakai aplikasi lain juga.
REDIS_PREFIX=taflow-

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Aplikasi tidak mengantrekan apa pun, jadi tidak ada worker di stack ini.
QUEUE_CONNECTION=sync

# ── Berkas (MinIO) ────────────────────────────────────────────────────────────
# Proposal, dokumen ujian, tanda tangan, dan logo. Bucket-nya privat: setiap
# berkas dibaca lewat aplikasi, yang memeriksa siapa yang meminta.
DOCUMENTS_DISK=s3
AWS_ENDPOINT=https://minio.kampus.ac.id
AWS_BUCKET=taflow
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_USE_PATH_STYLE_ENDPOINT=true

# ── Surel ─────────────────────────────────────────────────────────────────────
# Dipakai untuk tautan aktivasi dan setel ulang kata sandi.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@kampus.ac.id
MAIL_FROM_NAME="${APP_NAME}"

# ── SSO (Authelia) ───────────────────────────────────────────────────────────
# Opsional. Bila BASE_URL dan CLIENT_ID diisi, halaman login menampilkan tombol
# SSO. Hanya akun yang sudah dibuat prodi yang bisa masuk; email dicocokkan
# dengan akun yang ada. Daftarkan redirect URI di bawah pada client Authelia.
AUTHELIA_BASE_URL=https://auth.kampus.ac.id
AUTHELIA_CLIENT_ID=
AUTHELIA_CLIENT_SECRET=
AUTHELIA_REDIRECT_URI="${APP_URL}/auth/sso/callback"
AUTHELIA_LABEL="Masuk dengan SSO"

# ── Identitas institusi ───────────────────────────────────────────────────────
# Nilai awal kop dokumen resmi. Setelah superadmin menyimpannya dari layar
# Pengaturan Sistem, yang tersimpan di sana yang berlaku.
INSTITUTION_NAME="Nama Institusi"
INSTITUTION_UNIT=
INSTITUTION_ADDRESS=
INSTITUTION_PHONE=
INSTITUTION_WEBSITE=
INSTITUTION_CITY=Semarang

# ── Octane ────────────────────────────────────────────────────────────────────
# Jumlah worker: "auto" berarti satu per inti CPU.
OCTANE_WORKERS=auto
# Worker diganti yang baru setelah melayani sebanyak ini, untuk membuang
# memori yang menumpuk.
OCTANE_MAX_REQUESTS=1000
OCTANE_LOG_LEVEL=warn

# ── Batas sumber daya kontainer ───────────────────────────────────────────────
APP_MEMORY=2g
# 0 = tanpa batas CPU.
APP_CPUS=0
